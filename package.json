{
  "name": "edemand",
  "version": "1.0.0",
  "description": "DES428 case study — a production-grade on-demand home-services marketplace as a Next.js monolith (App Router + route handlers + SQLite), the system students migrate toward microservices",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "imports": {
    "#lib/*": "./lib/*"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "test": "node --test test/*.test.js",
    "test:pact": "node --test --test-concurrency=1 test/contracts/*.pact.test.js"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.2",
    "@opentelemetry/sdk-node": "0.223.2",
    "amqplib": "^0.10.4",
    "bcryptjs": "2.4.3",
    "better-sqlite3": "11.10.0",
    "jose": "5.10.0",
    "next": "14.2.35",
    "pino": "9.4.0",
    "prom-client": "15.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "uuid": "9.0.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@pact-foundation/pact": "16.5.0"
  }
}
