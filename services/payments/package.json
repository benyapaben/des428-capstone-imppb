{
  "name": "edemand-payments",
  "version": "1.0.0",
  "description": "Payments & Wallet service extracted from the eDemand monolith (Step 2): owns payment_intents, transactions, provider_wallets and webhook_events in its own Postgres, with an outbox.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --import ./src/otel.js src/server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.2",
    "@opentelemetry/instrumentation": "0.223.2",
    "@opentelemetry/instrumentation-express": "0.71.0",
    "@opentelemetry/instrumentation-http": "0.223.2",
    "@opentelemetry/instrumentation-pg": "0.76.0",
    "@opentelemetry/sdk-node": "0.223.2",
    "amqplib": "^0.10.4",
    "express": "4.21.2",
    "jose": "5.10.0",
    "pg": "8.13.1",
    "pino": "9.4.0",
    "zod": "3.23.8"
  }
}
